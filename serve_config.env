# vLLM-TorchTPU serve configuration — the ONLY file the autoserve agent edits.
# MODEL / parsers are fixed for a search run (see program.md).
#
# Why Qwen3.5-4B: CI-validated in vllm-torchtpu (supported_models.md), MTP speculative decoding
# and prefix caching validated on the Qwen3.5 family, fits one v6e chip (31.25 GiB usable HBM)
# with lots of KV room. Gemma 4 is the Google-model comparison run (stretch experiment).
MODEL="Qwen/Qwen3.5-4B"
TOOL_PARSER="qwen3_coder"
REASONING_PARSER="qwen3"
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=32
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.90
ENABLE_PREFIX_CACHING=1
# Speculative decoding: "" = off. MTP is lossless (same outputs), so it is the cleanest
# "make inference faster" knob: '{"method": "mtp", "num_speculative_tokens": 1}'
SPECULATIVE_CONFIG=""
KV_CACHE_DTYPE="auto"          # or fp8
EXTRA_ARGS=""
